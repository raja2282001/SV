# Express API
API_PORT=3001
# Browser API URL. Keep /api/v1 when frontend and API share one Render service.
VITE_API_BASE_URL=/api/v1
# Replace the placeholders with the connection string from your MongoDB provider.
# URL-encode any special characters in the username or password.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority"
t"
Set a strong private password before exposing the admin API.
ADMIN_PASSWORD=
# Optional: stable secret for admin tokens. A random local-only secret is used when omitted.
ADMIN_TOKEN_SECRET=
# Used when MONGODB_URI is not configured.
DATA_FILE=./data/catalogue.json
